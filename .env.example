# Application Environment: development, test, or production
APP_ENV=development

# JWT Secret: required secret string, must be at least 32 UTF-8 bytes
# Generate a secure key using: openssl rand -hex 32 or python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_this_with_a_secure_signing_secret_at_least_32_bytes_long

# JWT Algorithm: restricted to HS256
JWT_ALGORITHM=HS256

# Access token expiry in minutes (1 to 1440)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Database URL: default is anchored SQLite database in project root
DATABASE_URL=sqlite:///task_board.db

# CORS Allowed Origins: comma-separated list or JSON array of explicit origins (empty by default)
# Example: http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS=
